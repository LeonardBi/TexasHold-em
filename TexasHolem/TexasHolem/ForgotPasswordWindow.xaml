<Window x:Class="TexasHoldemClient.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reset Password" Height="500" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="30,20,30,20">

        <StackPanel x:Name="Step1Panel" Visibility="Visible">
            <TextBlock Text="Find Your Password" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Enter Username:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="UsernameBox" Height="30" Padding="5" FontSize="14"/>
                <Button Grid.Column="1" Content="Search" Margin="5,0,0,0" Click="SearchUserBtn_Click"/>
            </Grid>

            <StackPanel x:Name="QuestionsPanel" Visibility="Collapsed">

                <TextBlock x:Name="Q1Text" Text="Question 1:" FontWeight="Bold" Foreground="#333333" TextWrapping="Wrap" Margin="0,10,0,5"/>
                <TextBox x:Name="A1Box" Height="30" Padding="5" FontSize="14"/>

                <TextBlock x:Name="Q2Text" Text="Question 2:" FontWeight="Bold" Foreground="#333333" TextWrapping="Wrap" Margin="0,15,0,5"/>
                <TextBox x:Name="A2Box" Height="30" Padding="5" FontSize="14" Margin="0,0,0,20"/>

                <Button Content="Verify Answers" Height="40" FontSize="16" FontWeight="Bold" Click="VerifyBtn_Click"/>
            </StackPanel>

            <TextBlock x:Name="Step1Status" Foreground="Red" HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap"/>

            <Button Content="Back to Login" Background="Transparent" BorderThickness="0" Foreground="Blue" Cursor="Hand" Margin="0,20,0,0" Click="BackToLogin_Click"/>
        </StackPanel>

        <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
            <TextBlock Text="Set New Password" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="New Password" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <PasswordBox x:Name="NewPwdBox" Height="30" Margin="0,0,0,15" Padding="5" FontSize="14"/>

            <TextBlock Text="Confirm Password" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <PasswordBox x:Name="ConfirmPwdBox" Height="30" Margin="0,0,0,20" Padding="5" FontSize="14"/>

            <Button Content="Reset Password" Height="40" FontSize="16" FontWeight="Bold" Click="ResetPwdBtn_Click"/>

            <TextBlock x:Name="Step2Status" Foreground="Red" HorizontalAlignment="Center" Margin="0,10,0,0"/>

            <Button Content="Back to Login" Background="Transparent" BorderThickness="0" Foreground="Blue" Cursor="Hand" Margin="0,20,0,0" Click="BackToLogin_Click"/>
        </StackPanel>

    </Grid>
</Window>