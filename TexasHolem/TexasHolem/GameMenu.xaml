<Window x:Class="TexasHoldemClient.GameMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Texas Hold'em - Main Menu" Height="500" Width="400" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        IsVisibleChanged="Window_IsVisibleChanged">

    <Window.Background>
        <ImageBrush ImageSource="pack://application:,,,/Images/background.jpg" Stretch="UniformToFill"/>
    </Window.Background>

    <Grid>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" 
                Background="#A6000000" BorderBrush="#D4AF37" BorderThickness="1" 
                CornerRadius="15" Padding="35,30" Width="300">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" Opacity="0.8" Direction="270" ShadowDepth="5"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Texas Hold'em" FontSize="28" FontWeight="Bold" Foreground="#D4AF37" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock x:Name="WelcomeText" Text="Welcome, Guest!" FontSize="16" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <Button x:Name="OnlineBtn" Content="Online Game" Height="42" Margin="0,0,0,15" FontSize="16" FontWeight="Bold" Background="#1E1E1E" Foreground="#D4AF37" BorderBrush="#D4AF37" BorderThickness="1" Click="OnlineGameBtn_Click" Cursor="Hand"/>
                <Button x:Name="AuthBtn" Content="Login" Height="42" Margin="0,0,0,15" FontSize="16" FontWeight="Bold" Background="#1E1E1E" Foreground="#D4AF37" BorderBrush="#D4AF37" BorderThickness="1" Click="AuthBtn_Click" Cursor="Hand"/>
                <Button x:Name="OfflineBtn" Content="Offline Game" Height="42" Margin="0,0,0,15" FontSize="16" FontWeight="Bold" Background="#1E1E1E" Foreground="#D4AF37" BorderBrush="#D4AF37" BorderThickness="1" Click="OfflineGameBtn_Click" Cursor="Hand"/>

                <Button x:Name="SettingsMenuBtn" Content="Settings" Height="42" Margin="0,0,0,15" FontSize="16" FontWeight="Bold" Background="#1E1E1E" Foreground="#AAAAAA" BorderBrush="#555555" BorderThickness="1" Click="SettingsBtn_Click" Cursor="Hand"/>
                <Button x:Name="ExitGameBtn" Content="Exit" Height="42" FontSize="16" FontWeight="Bold" Background="#1E1E1E" Foreground="#E53935" BorderBrush="#E53935" BorderThickness="1" Click="ExitBtn_Click" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>