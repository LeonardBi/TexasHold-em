<Window x:Class="TexasHoldemClient.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Texas Hold'em - Sign Up" Height="700" Width="450" 
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Padding="30,20,30,20">
            <StackPanel VerticalAlignment="Top">
                <TextBlock Text="Welcome to Texas Hol'em" FontSize="26" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Username" FontWeight="SemiBold" Margin="0,5,0,0"/>
                <TextBox x:Name="RegUsernameBox" Height="35" Margin="0,5,0,15" Padding="5" FontSize="14"/>

                <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,5,0,0"/>
                <PasswordBox x:Name="RegPasswordBox" Height="35" Margin="0,5,0,15" Padding="5" FontSize="14"/>

                <TextBlock Text="Confirm Password" FontWeight="SemiBold" Margin="0,5,0,0"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Height="35" Margin="0,5,0,15" Padding="5" FontSize="14"/>

                <Separator Margin="0,10,0,20"/>

                <TextBlock Text="Security question 1" FontWeight="SemiBold" Margin="0,5,0,0"/>
                <ComboBox x:Name="Q1Dropdown" Height="35" Margin="0,5,0,5" VerticalContentAlignment="Center"
                          SelectionChanged="Q1Dropdown_SelectionChanged">
                    <ComboBoxItem Content="What is your mother's maiden name?" IsSelected="True"/>
                    <ComboBoxItem Content="What was the name of your first pet?"/>
                    <ComboBoxItem Content="In what city were you born?"/>
                    <ComboBoxItem Content="--- Custom Question ---"/>
                </ComboBox>
                <TextBox x:Name="CustomQ1Box" Height="35" Margin="0,0,0,5" Padding="5" Visibility="Collapsed" Tag="Type your own question..."/>
                <TextBox x:Name="A1Box" Height="35" Margin="0,0,0,15" Padding="5" FontSize="14" Tag="Answer 1"/>

                <TextBlock Text="Security question 2" FontWeight="SemiBold" Margin="0,5,0,0"/>
                <ComboBox x:Name="Q2Dropdown" Height="35" Margin="0,5,0,5" VerticalContentAlignment="Center"
                          SelectionChanged="Q2Dropdown_SelectionChanged">
                    <ComboBoxItem Content="What is your favorite book?" IsSelected="True"/>
                    <ComboBoxItem Content="What was the model of your first car?"/>
                    <ComboBoxItem Content="Where did you meet your spouse?"/>
                    <ComboBoxItem Content="--- Custom Question ---"/>
                </ComboBox>
                <TextBox x:Name="CustomQ2Box" Height="35" Margin="0,0,0,5" Padding="5" Visibility="Collapsed" Tag="Type your own question..."/>
                <TextBox x:Name="A2Box" Height="35" Margin="0,0,0,25" Padding="5" FontSize="14" Tag="Answer 2"/>

                <Button x:Name="SubmitRegBtn" Content="Sign up!" Height="45" FontSize="18" FontWeight="Bold"
                        Click="SubmitRegBtn_Click" Background="White" BorderBrush="Black" BorderThickness="1.5"/>

                <Button Content="Back to login" HorizontalAlignment="Right" Margin="0,15,0,0" 
                        Background="Transparent" BorderThickness="0" Foreground="Blue" Cursor="Hand"
                        Click="BackToLogin_Click"/>

                <TextBlock x:Name="RegStatusText" Text="" Foreground="Red" HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>