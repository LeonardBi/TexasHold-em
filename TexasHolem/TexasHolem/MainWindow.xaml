<Window x:Class="TexasHoldemClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Texas Hold'em - Login" Height="550" Width="450" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Window.Background>
        <ImageBrush ImageSource="pack://application:,,,/Images/background.jpg" Stretch="UniformToFill"/>
    </Window.Background>

    <Grid>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" 
                Background="#A6000000" BorderBrush="#D4AF37" BorderThickness="1" 
                CornerRadius="15" Padding="35,30" Width="340">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" Opacity="0.8" Direction="270" ShadowDepth="5"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Welcome to Texas Hold'em" FontSize="22" FontWeight="Bold" Foreground="#D4AF37" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,30"/>

                <TextBlock Text="Username" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="UsernameBox" Height="38" Padding="8,0" VerticalContentAlignment="Center" FontSize="15" Margin="0,0,0,15" Background="#4D000000" Foreground="White" BorderBrush="#D4AF37" BorderThickness="1"/>

                <TextBlock Text="Password" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <PasswordBox x:Name="PasswordBox" Height="38" Padding="8,0" VerticalContentAlignment="Center" FontSize="15" Margin="0,0,0,5" Background="#4D000000" Foreground="White" BorderBrush="#D4AF37" BorderThickness="1"/>

                <TextBlock Text="Forgot Password?" Foreground="#90CAF9" TextDecorations="Underline" Cursor="Hand" 
                           HorizontalAlignment="Right" Margin="0,0,0,25" MouseLeftButtonDown="ForgotPassword_Click"/>

                <TextBlock x:Name="StatusText" Text="" Foreground="#FF5252" HorizontalAlignment="Center" Margin="0,0,0,10" FontWeight="SemiBold"/>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="LoginBtn" Grid.Row="0" Grid.Column="0" Content="Login" FontSize="16" FontWeight="Bold" Background="#1E1E1E" Foreground="#D4AF37" BorderBrush="#D4AF37" BorderThickness="1" Cursor="Hand" Click="LoginBtn_Click"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="Sign up" FontSize="16" FontWeight="Bold" Background="#1E1E1E" Foreground="#D4AF37" BorderBrush="#D4AF37" BorderThickness="1" Cursor="Hand" Click="SignUpBtn_Click"/>

                    <Button Grid.Row="2" Grid.Column="0" Content="Back to Menu" FontSize="14" FontWeight="Bold" Background="#1E1E1E" Foreground="#AAAAAA" BorderBrush="#555555" BorderThickness="1" Cursor="Hand" Click="BackToMenu_Click"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="Exit" FontSize="14" FontWeight="Bold" Background="#1E1E1E" Foreground="#E53935" BorderBrush="#E53935" BorderThickness="1" Cursor="Hand" Click="ExitBtn_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>