<Window x:Class="TexasHoldemClient.OnlineGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Texas Hold'em - Online Game" Height="768" Width="1024" MinWidth="1024" MinHeight="768"
        WindowStartupLocation="CenterScreen" Background="#1a3b1c">
    <Grid>
        <Grid Width="960" Height="600" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40">

            <Grid Background="#1a3b1c" Margin="40,60,40,60">
                <Border Background="#3E2723" CornerRadius="220" BorderBrush="#1F1209" BorderThickness="4">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="30" Opacity="0.6" Direction="315" ShadowDepth="15"/>
                    </Border.Effect>
                    <Border x:Name="PokerTableArea" Margin="25" Background="#1B5E20" CornerRadius="195">
                        <Border Margin="40" BorderBrush="#4CAF50" BorderThickness="3" CornerRadius="155" Opacity="0.6"/>
                    </Border>
                </Border>
            </Grid>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-40,0,0">
                <TextBlock x:Name="PotText" Text="Pot: $0" Foreground="Gold" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                <StackPanel x:Name="CommunityCardsPanel" Orientation="Horizontal" HorizontalAlignment="Center" Height="100"/>
            </StackPanel>

            <Border x:Name="Seat0" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,0" Background="#B2000000" BorderThickness="2" BorderBrush="#55FFFFFF" CornerRadius="10" Padding="10" MinWidth="160" Visibility="Visible">
                <StackPanel>
                    <TextBlock x:Name="Name0" Text="等待加入..." Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="Chips0" Text="$0" Foreground="Gold" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="Status0" Text="-" Foreground="LightGray" FontSize="12" HorizontalAlignment="Center"/>
                    <StackPanel x:Name="Cards0" Orientation="Horizontal" Height="90" Margin="0,5,0,0" HorizontalAlignment="Center" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <Border x:Name="Seat1" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,0,0" Background="#B2000000" BorderThickness="2" BorderBrush="#55FFFFFF" CornerRadius="10" Padding="10" MinWidth="150" MinHeight="110" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="Name1" Text="Player 1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="Chips1" Text="$0" Foreground="Gold" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="Status1" Text="-" Foreground="LightGray" FontSize="12" HorizontalAlignment="Center"/>
                    <StackPanel x:Name="Cards1" Orientation="Horizontal" Height="90" MinWidth="130" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border x:Name="Seat2" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="160,0,0,0" Background="#B2000000" BorderThickness="2" BorderBrush="#55FFFFFF" CornerRadius="10" Padding="10" MinWidth="150" MinHeight="110" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="Name2" Text="Player 2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="Chips2" Text="$0" Foreground="Gold" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="Status2" Text="-" Foreground="LightGray" FontSize="12" HorizontalAlignment="Center"/>
                    <StackPanel x:Name="Cards2" Orientation="Horizontal" Height="90" MinWidth="130" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border x:Name="Seat3" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,0,0,0" Background="#B2000000" BorderThickness="2" BorderBrush="#55FFFFFF" CornerRadius="10" Padding="10" MinWidth="150" MinHeight="110" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="Name3" Text="Player 3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="Chips3" Text="$0" Foreground="Gold" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="Status3" Text="-" Foreground="LightGray" FontSize="12" HorizontalAlignment="Center"/>
                    <StackPanel x:Name="Cards3" Orientation="Horizontal" Height="90" MinWidth="130" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border x:Name="Seat4" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,160,0" Background="#B2000000" BorderThickness="2" BorderBrush="#55FFFFFF" CornerRadius="10" Padding="10" MinWidth="150" MinHeight="110" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="Name4" Text="Player 4" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="Chips4" Text="$0" Foreground="Gold" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="Status4" Text="-" Foreground="LightGray" FontSize="12" HorizontalAlignment="Center"/>
                    <StackPanel x:Name="Cards4" Orientation="Horizontal" Height="90" MinWidth="130" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border x:Name="Seat5" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,0,0" Background="#B2000000" BorderThickness="2" BorderBrush="#55FFFFFF" CornerRadius="10" Padding="10" MinWidth="150" MinHeight="110" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="Name5" Text="Player 5" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="Chips5" Text="$0" Foreground="Gold" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="Status5" Text="-" Foreground="LightGray" FontSize="12" HorizontalAlignment="Center"/>
                    <StackPanel x:Name="Cards5" Orientation="Horizontal" Height="90" MinWidth="130" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,20,0,0">
            <TextBlock x:Name="GameStateText" Text="Waiting for Players..." Foreground="LightGray" FontSize="18" FontWeight="Bold"/>
        </StackPanel>

        <Border x:Name="WarningToast" Background="#E6D32F2F" CornerRadius="8" Padding="20,10" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,150,0,0" Visibility="Collapsed" Panel.ZIndex="200">
            <TextBlock x:Name="WarningText" Text="警告信息" Foreground="White" FontSize="16" FontWeight="Bold"/>
        </Border>

        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="300" Height="200" Margin="20,0,0,20" Background="#B2000000" CornerRadius="8">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ListBox x:Name="ChatListBox" Grid.Row="0" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="13" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MessageTextBox" Grid.Column="0" Height="26" VerticalContentAlignment="Center" Background="#33FFFFFF" Foreground="White" BorderThickness="1" BorderBrush="#55FFFFFF" KeyDown="MessageTextBox_KeyDown"/>
                    <Button x:Name="SendBtn" Grid.Column="1" Content="Send" Click="SendBtn_Click" Width="50" Margin="5,0,0,0" Background="#FFB300" FontWeight="Bold" BorderThickness="0"/>
                </Grid>
            </Grid>
        </Border>

        <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel x:Name="PreGamePanel" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                <Button x:Name="ReadyBtn" Content="✔️ 准备 (Ready)" Click="ReadyBtn_Click" Height="40" Width="140" Background="#4CAF50" Foreground="White" FontWeight="Bold" FontSize="14"/>
            </StackPanel>

            <StackPanel x:Name="ActionPanel" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,15" Visibility="Collapsed">
                <Button x:Name="FoldBtn" Content="Fold 弃牌" Click="FoldBtn_Click" Height="45" Width="80" Margin="0,0,10,0" FontSize="14" FontWeight="Bold" Background="#424242" Foreground="White"/>
                <Button x:Name="CallBtn" Content="Check/Call" Click="CallBtn_Click" Height="45" Width="110" Margin="0,0,10,0" FontSize="14" FontWeight="Bold" Background="#FFB300" Foreground="Black"/>
                <TextBox x:Name="RaiseAmountInput" Text="300" Width="60" Height="45" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontWeight="Bold" FontSize="16" Margin="0,0,5,0"/>
                <Button x:Name="RaiseBtn" Content="Raise To 加注到" Click="RaiseBtn_Click" Height="45" Width="120" Margin="0,0,10,0" FontSize="14" FontWeight="Bold" Background="#D32F2F" Foreground="White"/>
                <Button x:Name="AllInBtn" Content="ALL-IN 梭哈" Click="AllInBtn_Click" Height="45" Width="100" FontSize="14" FontWeight="Bold" Background="#B71C1C" Foreground="Gold"/>
            </StackPanel>

            <StackPanel x:Name="SwapPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,15" Visibility="Collapsed">
                <Button x:Name="DoSwapBtn" Content="Swap 换选中牌" Click="DoSwapBtn_Click" Height="45" Width="140" Margin="0,0,10,0" FontSize="14" FontWeight="Bold" Background="#1565C0" Foreground="White"/>
                <Button x:Name="PassSwapBtn" Content="Keep 不换" Click="PassSwapBtn_Click" Height="45" Width="100" FontSize="14" FontWeight="Bold" Background="#424242" Foreground="White"/>
            </StackPanel>

            <StackPanel Grid.Row="3" VerticalAlignment="Bottom" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="SitOutBtn" Content="⏸️ 下局休息" Click="SitOutBtn_Click" Height="30" Width="120" Margin="0,0,10,0" Background="#9E9E9E" Foreground="White" FontWeight="Bold"/>
                <Button x:Name="SettingsBtn" Content="Settings" Click="SettingsBtn_Click" Height="30" Width="80" Margin="0,0,10,0" FontWeight="Bold"/>
                <Button x:Name="BackBtn" Content="Main Menu" Click="BackBtn_Click" Height="30" Width="100" FontWeight="Bold"/>
            </StackPanel>
        </Grid>

        <Border x:Name="CenterBroadcastToast" Background="#E6000000" CornerRadius="12" Padding="50,30" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Panel.ZIndex="100">
            <StackPanel>
                <TextBlock x:Name="WinnerText" Text="Winner!" Foreground="Gold" FontSize="32" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock x:Name="WinnerReason" Text="Reason" Foreground="White" FontSize="18" TextAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>